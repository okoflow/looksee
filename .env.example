# Docker

COMPOSE_PROJECT_NAME=looksee

# Network

WEBRTC_HOST_IP=127.0.0.1
API_PORT=8000
WEB_PORT=3000
RUNTIME_API_URL=
RUNTIME_WS_URL=
RUNTIME_MEDIAMTX_WEBRTC_URL=

# PostgreSQL

POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Redis

REDIS_PORT=6379

# MediaMTX

MTX_RTSP_PORT=8554
MTX_WEBRTC_PORT=8889
MTX_WEBRTC_ICE_PORT=8189
MTX_MEDIA_PASSWORD=

# S3

STORAGE_PASSWORD=
STORAGE_PORT=9000
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=looksee
S3_PREFIX=

# Inference

INFERENCE_CPUS=4.0
INFERENCE_MEMORY=4g

# Application

EVENT_TIMEZONE=UTC
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# Security

SECRET_KEY=
AUTH_COOKIE_SECURE=false

