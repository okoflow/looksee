WEBRTC_HOST_IP=127.0.0.1

REGISTRY=looksee
TAG=latest

# LookSee Enterprise license key; unset runs the community edition.
# LICENSE_KEY=

POSTGRES_USER=looksee
POSTGRES_PASSWORD=looksee
POSTGRES_DB=looksee
POSTGRES_PORT=5432

REDIS_PORT=6379
REDIS_MAXMEMORY=512mb

MTX_LOGLEVEL=info
MTX_RTSP_PORT=8554
MTX_WEBRTC_PORT=8889
MTX_WEBRTC_ICE_PORT=8189
MTX_MEDIA_USER=media
MTX_MEDIA_PASSWORD=looksee

# S3-compatible asset store for "file" camera sources — Cloudflare R2:
# endpoint https://<account_id>.r2.cloudflarestorage.com, region auto
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_REGION=auto
# S3_PREFIX=

API_PORT=8000
WEB_PORT=3000
INFERENCE_CPUS=4.0
INFERENCE_MEMORY=4g

# CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
# EVENT_TIMEZONE=UTC
# EVENT_COOLDOWN_SECONDS=2
# RECONCILE_INTERVAL_SECONDS=30

# Root secret for session signing and credential encryption. Unset, the api
# generates one on first boot and persists it in the api_keys volume; set it
# explicitly to survive volume loss or to share across replicas.
# SECRET_KEY=
# Mark session cookies Secure when the studio is served over HTTPS.
# AUTH_COOKIE_SECURE=true

# RTSP_TRANSPORT=tcp
# FIRST_FRAME_TIMEOUT_SECONDS=30
# LAST_FRAME_TTL_SECONDS=10

# RUNTIME_API_URL=
# RUNTIME_WS_URL=
# RUNTIME_MEDIAMTX_WEBRTC_URL=
# RUNTIME_DOCS_URL=
# RUNTIME_GITHUB_URL=

# Native development outside compose (compose pins container URLs itself)
# DATABASE_URL=postgresql+asyncpg://looksee:looksee@localhost:5432/looksee
# REDIS_URL=redis://localhost:6379/0
# MEDIAMTX_API_URL=http://localhost:9997
# MEDIAMTX_RTSP_URL=rtsp://localhost:8554
# MEDIA_MOUNT_DIR=/media
# MEDIA_CACHE_DIR=./data/media-cache
# MODELS_DIR=./models
# SNAPSHOTS_DIR=./data/snapshots
# SECRET_KEY_FILE=./data/secret.key
